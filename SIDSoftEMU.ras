program SIDSoftEMU;
@use "TVC"
@use "GE"

/* SIDSoftEMU - 1. teszt (2026-10-31): 3 hangos SID-szeru szintezis, "A" valtozat.
   - Hang-IT 5008 Hz-en (port 4 = $D9, port 5 = $0F + IT-bit). Az IT-ben 3 fazisszamlalo: IX, IY, HL'.
     Hangonkent egy 5 byte-os "rés" (V1SH..V3SH): tabla (ld e,a / ld d,lap / ld a,(de) / nop) vagy
     negyszog (cp PW / sbc a,a / and AMP). Osszeg -> port 6 (bit 2-5), bit 0-1 = grafikus mod (1 = Graphics 4).
   - A fo program kepkockankent (100 IT = 50,08 Hz) futtatja a lejatszot (ADSR, PWM, dal), majd di/ei kozott
     atirja a reseket es a fazislepeseket.
   - Meres a keretben: az IT alatt PIROS keret, a lejatszo alatt ZOLD, szabad ido FEKETE (SidKeret).
   TILOS a fo programban: IX, IY, a shadow regiszterek (exx, ex af) -> GE rajzolo rutinok sem hivhatok,
   amig a hang szol (a FillRect is hasznalja oket).
   Adat: tools/sid_tvc_adat.py -> resources/sid_adat.bin, betoltve $6000-ra (program vege < $6000!).
   Mac: Cmd+Shift+B (resources/build_mac.sh); Windows: resources\build.ps1 */

var
	SidAdat	:	incbin("resources/sid_adat.bin");

	/* a $6000-ra masolt adat reszei */
	StepLo	:	array[128] of byte at $7000;
	StepHi	:	array[128] of byte at $7080;
	AmpTab	:	array[16] of byte at $7100;
	Hangszer:	array[40] of byte at $7110;
	Dal		:	array[2048] of byte at $7140;

	/* hangonkenti allapot */
	Lvl		:	array[3] of byte;
	Allapot	:	array[3] of byte;	/* 0 attack, 1 decay/sustain, 2 release */
	Rovid	:	array[3] of byte;
	Hullam	:	array[3] of byte;
	Att		:	array[3] of byte;
	Dek		:	array[3] of byte;
	Sus		:	array[3] of byte;
	Rel		:	array[3] of byte;
	SLo		:	array[3] of byte;
	SHi		:	array[3] of byte;
	Res		:	array[15] of byte;	/* 3 x 5 byte a V1SH..V3SH-ba */

	DalPos	:	integer;
	FCnt, v, n, ii, amp, o, PW, PWIrany	:	byte;

/* ---------------------------------------------------------------- hang-IT + inditas */
procedure SidStart();
begin
	asm("
		di
		ld	hl,SidAdat
		ld	de,$6000
		ld	bc,end_incbin_SidAdat-SidAdat		;	pontosan a fajl hossza
		ldir
		;	a 3 res kezdetben: tabla, 0. lap = csend
		ld	hl,V1SH
		call	SidResCsend
		ld	hl,V2SH
		call	SidResCsend
		ld	hl,V3SH
		call	SidResCsend
		ld	ix,0
		ld	iy,0
		exx
		ld	hl,0
		ld	c,100
		ld	b,0
		exx
		;	$38: JP SidIT
		ld	hl,$38
		ld	(hl),195
		ld	de,SidIT
		inc	hl
		ld	(hl),e
		inc	hl
		ld	(hl),d
		;	hang-IT: 5008 Hz (mint a music.tru)
		ld	a,($0B12)
		and	128+64
		or	15+32
		ld	($0B12),a
		ld	c,91
		in	b,(c)
		out	($05),a
		ld	a,$D9
		out	($04),a
		;	kurzor-IT ki (CRTC R10/R11 bit 5)
		ld	a,10
		out	($70),a
		ld	a,3+32
		out	($71),a
		ld	a,11
		out	($70),a
		ld	a,3+32
		out	($71),a
		ei
		ret

	SidResCsend:
		ld	(hl),$5F
		inc	hl
		ld	(hl),$16
		inc	hl
		ld	(hl),$60
		inc	hl
		ld	(hl),$1A
		inc	hl
		ld	(hl),0
		ret

	SidFlag:
		db	0
	SidKeret:
		db	0		;	a fo program keretszine (az IT vegen ez all vissza)

	;	------------------------------------------------ A HANG-IT (~266 ciklus a belepessel)
	SidIT:
		ex	af,af'
		exx
		out	($07),a
		ld	a,136			;	keret: piros (meres)
		out	($00),a
	V1ST:
		ld	de,0
		add	ix,de
		ld	a,ixh
	V1SH:
		ld	e,a
		ld	d,$60
		ld	a,(de)
		nop
		ld	b,a
	V2ST:
		ld	de,0
		add	iy,de
		ld	a,iyh
	V2SH:
		ld	e,a
		ld	d,$60
		ld	a,(de)
		nop
		add	a,b
		ld	b,a
	V3ST:
		ld	de,0
		add	hl,de
		ld	a,h
	V3SH:
		ld	e,a
		ld	d,$60
		ld	a,(de)
		nop
		add	a,b
		or	1
		out	($06),a
		dec	c
		jr	z,SidKep
	SidVege:
		ld	a,(SidKeret)
		out	($00),a
		exx
		ex	af,af'
		ei
		ret
	SidKep:
		ld	c,100
		ld	a,1
		ld	(SidFlag),a
		jr	SidVege
	");
end;

/* ---------------------------------------------------------------- kepkocka-varas, keretszin */
procedure VarKepkocka();
begin
	asm("
		xor	a
		ld	(SidKeret),a
		out	($00),a
	VarKor:
		ld	a,(SidFlag)
		or	a
		jr	z,VarKor
		xor	a
		ld	(SidFlag),a
		ld	a,160			;	keret: zold = lejatszo
		ld	(SidKeret),a
		out	($00),a
	");
end;

/* ---------------------------------------------------------------- a resek atirasa (di/ei) */
procedure ResIras();
begin
	asm("
		di
		ld	hl,Res
		ld	de,V1SH
		ld	bc,5
		ldir
		ld	de,V2SH
		ld	bc,5
		ldir
		ld	de,V3SH
		ld	bc,5
		ldir
		ld	a,(SLo)
		ld	(V1ST+1),a
		ld	a,(SHi)
		ld	(V1ST+2),a
		ld	a,(SLo+1)
		ld	(V2ST+1),a
		ld	a,(SHi+1)
		ld	(V2ST+2),a
		ld	a,(SLo+2)
		ld	(V3ST+1),a
		ld	a,(SHi+2)
		ld	(V3ST+2),a
		ei
	");
end;

/* ---------------------------------------------------------------- lejatszo, kepkockankent */
procedure Lejatszo();
begin
	if (FCnt = 0) then
	begin
		if (Dal[DalPos] = 255) then DalPos := 0;
		for v := 0 to 3 do
		begin
			n := Dal[DalPos];
			ii := Dal[DalPos + 1];
			DalPos := DalPos + 2;
			if (n = 1) then Allapot[v] := 2;
			if (n >= 2) then
			begin
				SLo[v] := StepLo[n];
				SHi[v] := StepHi[n];
				o := ii * 5;
				Hullam[v] := Hangszer[o];
				Att[v] := Hangszer[o + 1];
				Dek[v] := Hangszer[o + 2];
				Sus[v] := Hangszer[o + 3];
				Rel[v] := Hangszer[o + 4];
				Allapot[v] := 0;
				Rovid[v] := 0;
				if (Sus[v] = 0) then Rovid[v] := 1;
			end;
		end;
	end;
	if (FCnt = 1) then
	begin
		for v := 0 to 3 do
			if (Rovid[v] = 1) then
			begin
				Allapot[v] := 2;
				Rovid[v] := 0;
			end;
	end;

	for v := 0 to 3 do
	begin
		n := Lvl[v];
		if (Allapot[v] = 0) then
		begin
			if (255 - n <= Att[v]) then
			begin
				n := 255;
				Allapot[v] := 1;
			end
			else
				n := n + Att[v];
		end
		else if (Allapot[v] = 1) then
		begin
			if (n > Sus[v]) then
			begin
				if (n - Sus[v] > Dek[v]) then n := n - Dek[v] else n := Sus[v];
			end;
		end
		else
		begin
			if (n > Rel[v]) then n := n - Rel[v] else n := 0;
		end;
		Lvl[v] := n;

		amp := AmpTab[n >> 4];
		o := v * 5;
		if (amp = 0) then
		begin
			Res[o] := $5F;		/* ld e,a */
			Res[o + 1] := $16;	/* ld d,lap */
			Res[o + 2] := $60;
			Res[o + 3] := $1A;	/* ld a,(de) */
			Res[o + 4] := 0;	/* nop */
		end
		else if (Hullam[v] = 3) then
		begin
			Res[o] := $FE;		/* cp PW */
			Res[o + 1] := PW;
			Res[o + 2] := $9F;	/* sbc a,a */
			Res[o + 3] := $E6;	/* and AMP*4 */
			Res[o + 4] := amp << 2;
		end
		else
		begin
			Res[o] := $5F;
			Res[o + 1] := $16;
			Res[o + 2] := $61 + Hullam[v] * 5 + amp - 1;
			Res[o + 3] := $1A;
			Res[o + 4] := 0;
		end;
	end;

	/* PWM-sopres 26..230, 3-asaval (mint a modellben) */
	if (PWIrany = 0) then
	begin
		if (PW + 3 > 230) then PWIrany := 1 else PW := PW + 3;
	end;
	if (PWIrany = 1) then
	begin
		if (PW < 29) then
		begin
			PWIrany := 0;
			PW := PW + 3;
		end
		else PW := PW - 3;
	end;

	FCnt := FCnt + 1;
	if (FCnt = 6) then FCnt := 0;
end;

begin
	GE::SetGraphics(GE::GRAPHICS4);
	GE::Init(GE::DIRECT_TO_SCREEN);	/* a firmware IT-kezelot kikapcsolja */
	GE::SetMemory(GE::MEM_VID_ON);	/* U0, U1, VID, SYS */

	GE::SetPalette(0, GE::PALETTE_BLACK);
	GE::SetPalette(1, GE::PALETTE_CYAN);
	GE::SetPalette(2, GE::PALETTE_RED);
	GE::SetPalette(3, GE::PALETTE_YELLOW);
	GE::SetBorder(GE::BORDER_BLACK);
	GE::ClearScreen(GE::GR4_COLOR0);

	DalPos := 0;
	FCnt := 0;
	PW := 128;
	PWIrany := 0;
	for v := 0 to 3 do
	begin
		Lvl[v] := 0;
		Allapot[v] := 2;
		Rovid[v] := 0;
		Hullam[v] := 0;
		SLo[v] := 0;
		SHi[v] := 0;
	end;

	SidStart();

	while (true) do
	begin
		VarKepkocka();
		Lejatszo();
		ResIras();
	end;
end.
