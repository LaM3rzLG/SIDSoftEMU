program FajlTeszt16;
@use "GE"

/* FajlTeszt16 - a FajlTeszt 16 szinu (GRAPHICS16) valtozata: kiiras Ir16 + font16.bin (lasd Ir16Teszt.ras),
   sorkoz 12, 14 sor latszik, oszlop = byte = 2 pont. A tobbi a FajlTeszt-e (alabb).
   FajlTeszt - a SIDSoftEMU mini fajlkezelojenek probaprogramja (2026-10-31), TRSE + GE unit.
   - Kiiras: a WaterPumpGame SAJAT szovegkiiroja (Ir: aranyos, pixelszelessegu betuk, 1 bites font), valtozatlanul
     atveve; csak a sorpuffer lett Ir_Buf (a WPG-ben $1460). Betukeszlet: resources/font.bin (1 byte magassag +
     109 byte szelesseg + kep; ASCII 32..122 + ekezetek). Ekezet a forrasban Latin-1-gyel; o"/u" helyett o^/u^.
   - Billentyuk: GE::GetKeyboard + GE::Pressed (a nyilak a matrix 8. soraban: JOY1_UP/DOWN/LEFT/RIGHT).
     Nyomva tartva ismetel (elso ismetles 20 kep utan, aztan 3 kepenkent).
   - Mozgaskor csak a regi es az uj sor jele rajzolodik ujra; a teljes lista csak lapozaskor / konyvtarvaltaskor.
   - Konyvtar: a lemez-ROM FISH hivasa (MOPS rst $30 / $DB; 04H = elso, 05H = kovetkezo bejegyzes) - FishHivas.
     ROM-hivas elott GE::EnableTVCITHandler, utana Disable.
   Fel/Le = valasztas, Balra/Jobbra = lapozas, Enter = konyvtarba be / .STC (most csak kiirja), ESC = feljebb. */

var
	Font16_Data	:	incbin("resources/font16_kek_cian.bin");
	Logo_Data	:	incbin("resources/images/C64_logo_forog.bin");	/* maszkolt GE sprite, 6 byte x 17 sor, 16 fazis */
	Logo		:	GE::Sprite;
	const LOGO_X		: byte = 57;	/* jobb felso sarok (byte) */
	const LOGO_Y		: byte = 3;
	const LOGO_FAZIS	: byte = 16;
	const LOGO_KESL		: byte = 3;		/* kepkocka / fazis (a sprite-szerkeszto "speed" erteke) */

	const LATHATO	: byte = 14;		/* ennyi listasor latszik */
	const LISTA_Y	: byte = 27;		/* az elso listasor kepsora */
	const ALLAPOT_Y	: byte = 200;		/* uzenetsor */
	const NEV_X		: byte = 3;			/* oszlopok (byte = 4 pont) */
	const MERET_JOBB: byte = 54;		/* a meret jobb szele */
	const KVT_X		: byte = 36;

	Lista		:	array[4096] of byte;	/* 256 bejegyzes x 16: nev 8, kit. 3, attr 1, meret 4 */
	MintaFcb	:	array[64] of byte;		/* keresesi minta (????????.???) */
	TalaltFcb	:	array[64] of byte;		/* a talalt bejegyzes */
	Fpb			:	array[8] of byte;		/* FISH parameterblokk: IX, HL, DE, BC */
	Ut			:	array[64] of byte;		/* aktualis konyvtar, 0-val zarva; gyoker = \ */
	Nev			:	array[14] of byte;		/* a bejegyzes neve (nev.kit) */
	SzamSz		:	array[8] of byte;		/* szam szovegkent */

	UtHossz, NevHossz, Db, Sel, Top, Regi, HibaKod	:	byte;
	FishKod, FishHiba	:	byte;
	Gomb, ElozoGomb, Ismetles	:	byte;
	i, j, k, b, y, Elso	:	byte;
	p			:	^byte;
	a, Meret	:	integer;

	/* az Ir16 valtozoi (Ir16Teszt) */
	Ir16_X							:	byte = 0;
	Ir16_Y							:	byte = 0;
	Ir16_Szoveg						:	^byte;
	Ir16_Szel, Ir16_Px, Ir16_Bdb, Ir16_H	:	byte = 0;
	Ir16_Hossz						:	byte = 0;
	Ir16_Hatter						:	byte = 0;
	SavY, SavMod, Cs_S, Cs_Y0, Cs_N	:	byte = 0;
	const SAV_SZIN	: byte = GE::GR16_COLOR_DARKMAGENTA;	/* a kiemelo sav (GR16 minta); a font16_kek_cian 0,1,5,8,9,10,13-at hasznal */
	Sav_L, Sav_R	:	byte = 0;	/* a csuszo kiemelo sav (SavSor, Csusztat) */		/* a szoveg teglalapjanak szine (GR16 minta); a betu OR-ral kerul ra */
	Ir16_Dst						:	integer = 0;


/* ---------------------------------------------------------------- 16 SZINU ARANYOS SZOVEGKIIRO (Ir16Teszt) */
Procedure Ir16(Ir16_X, Ir16_Y : global byte; Ir16_Szoveg : global ^byte);
	begin
		asm("
			ld a,[Ir16_Y]
			ld l,a
			ld h,0
			add hl,hl
			add hl,hl
			add hl,hl
			add hl,hl
			add hl,hl
			add hl,hl
			ld de,[GE_ScreenAddr]
			add hl,de
			ld a,[Ir16_X]
			ld e,a
			ld d,0
			add hl,de
			ld [Ir16_Dst],hl
			ld hl,[Ir16_Szoveg]
			call Ir16_PxSzel
			ld [Ir16_Bdb],a
			or a
			jp z,Ir16_Vege
; 1. a szoveg teglalapja fekete (Bdb x magassag)
			ld a,[Font16_Data]
			and 15
			ld [Ir16_H],a
			ld b,a
			ld hl,[Ir16_Dst]
Ir16Torol:
			push bc
			push hl
			ld a,[Ir16_Hatter]
			ld (hl),a
			ld a,[Ir16_Bdb]
			dec a
			jr z,Ir16Torol1
			ld c,a
			ld b,0
			ld d,h
			ld e,l
			inc de
			ldir
Ir16Torol1:
			pop hl
			ld de,64
			add hl,de
			pop bc
			djnz Ir16Torol
; 2. betunkent az osszes sor, OR-ral a kepre
			xor a
			ld [Ir16_Px],a
			ld hl,[Ir16_Szoveg]
Ir16Kar:
			ld a,(hl)
			or a
			jp z,Ir16KarVeg
			inc hl
			call Ir16_Ekezet
			cp 32
			jr c,Ir16Kar
			cp 141
			jr nc,Ir16Kar
			sub 32
			push hl
			ld e,a
			ld d,0
			ld hl,Font16_Data+1
			add hl,de
			ld a,(hl)
			or a
			jp z,Ir16KarKesz
			ld [Ir16_Szel],a
			ex de,hl
			add hl,hl
			add hl,hl
			ld de,Font16_Data+110
			add hl,de
			push hl
			ld a,[Ir16_Px]
			srl a
			ld e,a
			ld d,0
			ld hl,[Ir16_Dst]
			add hl,de
			ex de,hl
			pop hl
			ld a,[Ir16_H]
			ld b,a
			ld a,[Ir16_Px]
			rrca
			jr c,Ir16Paratlan
Ir16Paros:
			ld a,(de)
			or (hl)
			ld (de),a
			inc hl
			inc de
			ld a,(de)
			or (hl)
			ld (de),a
			inc hl
			inc de
			ld a,(de)
			or (hl)
			ld (de),a
			inc hl
			inc de
			ld a,(de)
			or (hl)
			ld (de),a
			inc hl
			ld a,l
			add a,432-256
			ld l,a
			ld a,h
			adc a,1
			ld h,a
			ld a,e
			add a,61
			ld e,a
			jr nc,Ir16P1
			inc d
Ir16P1:
			djnz Ir16Paros
			jr Ir16Lep
; paratlan pont: a bal pont (bit 7,5,3,1) a jobb helyere (>>1), a jobb pont (bit 6,4,2,0) a kovetkezo byte bal helyere (<<1)
Ir16Paratlan:
			push bc
			ld c,0
			ld b,4
Ir16Tol:
			ld a,(hl)
			and $AA
			rrca
			or c
			ex de,hl
			or (hl)
			ld (hl),a
			ex de,hl
			ld a,(hl)
			and $55
			rlca
			ld c,a
			inc hl
			inc de
			djnz Ir16Tol
			ld a,(de)
			or c
			ld (de),a
			ld a,l
			add a,432-256
			ld l,a
			ld a,h
			adc a,1
			ld h,a
			ld a,e
			add a,60
			ld e,a
			jr nc,Ir16T1
			inc d
Ir16T1:
			pop bc
			djnz Ir16Paratlan
Ir16Lep:
			ld a,[Ir16_Szel]
			ld c,a
			ld a,[Ir16_Px]
			add a,c
			ld [Ir16_Px],a
Ir16KarKesz:
			pop hl
			jp Ir16Kar
Ir16KarVeg:
			ld a,[Ir16_Bdb]
			ld e,a
			ld a,[Ir16_X]
			add a,e
			ld [Ir16_X],a
			jp Ir16_Vege
; a szoveg szelessege: HL = szoveg -> A = byte (2 pont), felfele kerekitve
Ir16_PxSzel:
			ld c,0
Ir16_PKov:
			ld a,(hl)
			or a
			jr z,Ir16_PVege
			inc hl
			call Ir16_Ekezet
			cp 32
			jr c,Ir16_PKov
			cp 141
			jr nc,Ir16_PKov
			sub 32
			push hl
			ld e,a
			ld d,0
			ld hl,Font16_Data+1
			add hl,de
			ld a,(hl)
			add a,c
			ld c,a
			pop hl
			jr Ir16_PKov
Ir16_PVege:
			ld l,c
			ld h,0
			inc hl
			srl h
			rr l
			ld a,l
			ret
; Ekezetes betu: Latin-1 ($C0..$FF) -> a font kodja (123..140); ismeretlen -> 0 (kimarad). A WPG Ir_Ekezet masa.
Ir16_Ekezet:
			cp $C0
			ret c
			push hl
			sub $C0
			ld d,a
			and $1F
			ld e,a
			ld a,d
			ld d,0
			ld hl,Ir16_EkTab
			add hl,de
			ld e,a
			ld a,(hl)
			or a
			jr z,Ir16_EkX
			bit 5,e
			jr z,Ir16_EkX
			add a,9
Ir16_EkX:
			pop hl
			ret
Ir16_EkTab:
			db 0,123,0,0,0,0,0,0,0,124,0,0,0,125,0,0
			db 0,0,0,126,128,0,127,0,0,0,129,131,130,0,0,0
Ir16_Vege:
		");
	end;

/* Egy szoveg szelessege byte-ban (2 pont) -> Ir16_Hossz */
Procedure Ir16_Hossza(Ir16_Szoveg : global ^byte);
	begin
		asm("
			ld hl,[Ir16_Szoveg]
			call Ir16_PxSzel
			ld [Ir16_Hossz],a
		");
	end;


/* ---------------------------------------------------------------- kiemelo sav, egy pontsor (64 byte) a SavY kepsorban
   A hatter mindig fekete, igy a pont maga a maszk: 0 = hatter, mas = betu. A sav szine (SAV_SZIN) NE legyen a fontban.
   SavMod = 1: a fekete (0) pontok sav-szinuek lesznek; SavMod = 0: a sav-szinu pontok feketek. A betu pontjai nem valtoznak.
   Sav_L / Sav_R = a sav szinenek bal / jobb pontja (SAV_SZIN & $AA / & $55). */
procedure SavSor(SavY, SavMod : global byte);
begin
	asm("
		ld a,[SavY]
		ld l,a
		ld h,0
		add hl,hl
		add hl,hl
		add hl,hl
		add hl,hl
		add hl,hl
		add hl,hl
		ld de,[GE_ScreenAddr]
		add hl,de
		ld b,64
		ld a,[Sav_L]
		ld d,a
		ld a,[Sav_R]
		ld e,a
		ld a,[SavMod]
		or a
		jr z,SavTorol
SavFest:
		ld a,(hl)
		ld c,a
		and $AA
		jr nz,SavF1
		ld a,c
		or d
		ld c,a
SavF1:
		ld a,c
		and $55
		jr nz,SavF2
		ld a,c
		or e
		ld c,a
SavF2:
		ld (hl),c
		inc hl
		djnz SavFest
		jr SavVege
SavTorol:
		ld a,(hl)
		ld c,a
		and $AA
		cp d
		jr nz,SavT1
		ld a,c
		and $55
		ld c,a
SavT1:
		ld a,c
		and $55
		cp e
		jr nz,SavT2
		ld a,c
		and $AA
		ld c,a
SavT2:
		ld (hl),c
		inc hl
		djnz SavTorol
SavVege:
	");
end;


/* ---------------------------------------------------------------- az egyetlen asm: FISH-hivas
   C = FishKod (04H elso / 05H kovetkezo keresese), DE -> FPB {IX = 0, HL = ut, DE = MintaFcb, BC = TalaltFcb};
   eredmeny: FishHiba (0 = van bejegyzes). A hivas a $70-es lapozassal megy (mint a SIDSoftEMU-ban). */
procedure FishHivas();
begin
	asm("
		push	ix
		push	iy
		ld	hl,0
		ld	(Fpb),hl
		ld	hl,Ut
		ld	(Fpb+2),hl
		ld	hl,MintaFcb
		ld	(Fpb+4),hl
		ld	hl,TalaltFcb
		ld	(Fpb+6),hl
		ld	a,($0003)
		push	af
		ld	a,$70
		ld	($0003),a
		out	($02),a
		ld	a,(FishKod)
		ld	c,a
		ld	de,Fpb
		rst	$30
		db	$DB
		ld	(FishHiba),a
		pop	af
		ld	($0003),a
		out	($02),a
		pop	iy
		pop	ix
	");
end;


/* ---------------------------------------------------------------- p := a Sel-edik ... k-adik bejegyzes cime */
procedure BejCim(n : byte);
begin
	a := n;
	a := a * 16;
	p := #Lista;
	p := p + a;
end;


/* a p bejegyzes neve -> Nev (szokozok nelkul, nev.kit), NevHossz */
procedure NevMasol();
begin
	NevHossz := 0;
	j := 0;
	while (j < 8) do
	begin
		b := p[j];
		if (b <> 32) then
		begin
			Nev[NevHossz] := b;
			NevHossz := NevHossz + 1;
		end;
		j := j + 1;
	end;
	if (p[8] <> 32) then
	begin
		Nev[NevHossz] := 46;		/* . */
		NevHossz := NevHossz + 1;
		while (j < 11) do
		begin
			b := p[j];
			if (b <> 32) then
			begin
				Nev[NevHossz] := b;
				NevHossz := NevHossz + 1;
			end;
			j := j + 1;
		end;
	end;
	Nev[NevHossz] := 0;
end;


/* Meret -> SzamSz (vezeto nullak nelkul) */
procedure Jegy(oszto : integer);
begin
	b := 48;
	while (Meret >= oszto) do
	begin
		Meret := Meret - oszto;
		b := b + 1;
	end;
	if (b <> 48) then Elso := 0;
	if (Elso = 0) then
	begin
		SzamSz[k] := b;
		k := k + 1;
	end;
end;

procedure SzamIr();
begin
	k := 0;
	Elso := 1;
	Jegy(10000);
	Jegy(1000);
	Jegy(100);
	Jegy(10);
	Elso := 0;
	Jegy(1);
	SzamSz[k] := 0;
end;


/* ---------------------------------------------------------------- kepernyo */
/* a lista n-edik bejegyzese az y kepsorba */
/* a sor szovegei (nev, meret / konyvtar) az Ir16_Hatter szinu teglalapokra; a hatteret nem torli */
procedure SorSzoveg(n : byte);
begin
	BejCim(n);
	NevMasol();
	Ir16(NEV_X, y, #Nev);
	if ((p[11] & 16) <> 0) then
		Ir16(KVT_X, y, "<Könyvtár>")
	else
	begin
		/* meret KB-ban, felfele kerekitve: (b1 >> 2) + b2 * 64 */
		Meret := p[14];
		Meret := Meret * 64;
		b := p[13];
		b := b >> 2;
		Meret := Meret + b;
		b := p[13] & 3;
		if (p[12] <> 0) then b := 1;
		if (b <> 0) then Meret := Meret + 1;
		SzamIr();
		Ir16_Hossza(#SzamSz);
		Ir16(MERET_JOBB - Ir16_Hossz, y, #SzamSz);
		Ir16(MERET_JOBB + 1, y, "KB");
	end;
end;


procedure SorRajz(n : byte);
begin
	/* feketen kirajzolva; a kijelolt sor alatt a fekete pontok kekek lesznek (sav) */
	GE::FillRect(0, y - 1, 64, 12, 0);
	SorSzoveg(n);
	if (n = Sel) then
	begin
		Cs_S := 0;
		while (Cs_S < 12) do
		begin
			SavSor(y - 1 + Cs_S, 1);
			Cs_S := Cs_S + 1;
		end;
	end;
end;


procedure ListaRajz();
begin
	i := 0;
	while (i < LATHATO) do
	begin
		y := LISTA_Y + i * 12;
		a := Top;
		a := a + i;
		if (a < Db) then
			SorRajz(Top + i)
		else
			GE::FillRect(0, y - 1, 64, 12, 0);
		i := i + 1;
	end;
	if (Db = 0) then
	begin
		Ir16(NEV_X, LISTA_Y, "(üres) hiba: ");
		Meret := HibaKod;
		SzamIr();
		Ir16(Ir16_X, LISTA_Y, #SzamSz);
	end;
end;


procedure Allapot(szoveg : ^byte);
begin
	GE::FillRect(0, ALLAPOT_Y, 64, 12, 0);
	Ir16(0, ALLAPOT_Y, szoveg);
end;


procedure Rajz();
begin
	GE::ClearScreen(GE::GR16_COLOR_BLACK);
	Ir16(0, 0, "SIDSoftEMU fájlkezelô");
	Ir16(0, 12, #Ut);
	GE::FillRect(0, 24, 64, 1, GE::GR16_COLOR_DARKBLUE);
	GE::FillRect(0, 197, 64, 1, GE::GR16_COLOR_DARKBLUE);
	Ir16(0, 214, "Fel/Le: választás  Bal/Jobb: lap");
	Ir16(0, 226, "Enter: megnyitás  ESC: vissza");
	ListaRajz();
end;


/* ---------------------------------------------------------------- konyvtar beolvasasa -> Lista, Db */
procedure Olvas();
begin
	Db := 0;
	MintaFcb[0] := $FF;
	k := 1;
	while (k < 8) do
	begin
		MintaFcb[k] := 0;
		k := k + 1;
	end;
	while (k < 19) do
	begin
		MintaFcb[k] := $3F;		/* ? */
		k := k + 1;
	end;
	GE::EnableTVCITHandler();
	FishKod := 4;
	FishHivas();
	while (FishHiba = 0) do
	begin
		/* a . bejegyzes kimarad */
		b := 1;
		if (TalaltFcb[8] = 46) then
			if (TalaltFcb[9] = 32) then b := 0;
		if (b = 1) then
		begin
			BejCim(Db);
			k := 0;
			while (k < 12) do
			begin
				p[k] := TalaltFcb[k + 8];
				k := k + 1;
			end;
			while (k < 16) do
			begin
				p[k] := TalaltFcb[k + 24];		/* meret: TalaltFcb[36..39] */
				k := k + 1;
			end;
			Db := Db + 1;
		end;
		FishKod := 5;
		if (Db = 255) then FishHiba := 1
		else FishHivas();
	end;
	HibaKod := FishHiba;
	GE::DisableTVCITHandler();
	Sel := 0;
	Top := 0;
end;


/* ---------------------------------------------------------------- mozgas */
/* a sav atcsuszik a Regi sorbol a szomszedos Sel sorba: pontsoronkent, kepkockankent 3 sor (4 kepkocka) */
procedure Csusztat();
begin
	Cs_Y0 := LISTA_Y - 1 + (Regi - Top) * 12;
	Cs_N := 0;
	Cs_S := 0;
	while (Cs_S < 12) do
	begin
		if (Sel > Regi) then
		begin
			SavSor(Cs_Y0 + Cs_S, 0);
			SavSor(Cs_Y0 + 12 + Cs_S, 1);
		end
		else
		begin
			SavSor(Cs_Y0 + 11 - Cs_S, 0);
			SavSor(Cs_Y0 - 1 - Cs_S, 1);
		end;
		Cs_S := Cs_S + 1;
		Cs_N := Cs_N + 1;
		if (Cs_N = 3) then
		begin
			Cs_N := 0;
			GE::WaitForSync();
		end;
	end;
end;


procedure UjSel(n : byte);
begin
	Regi := Sel;
	Sel := n;
	if (Sel < Top) then
	begin
		Top := Sel;
		ListaRajz();
	end
	else
	if (Sel - Top >= LATHATO) then
	begin
		Top := Sel - LATHATO + 1;
		ListaRajz();
	end
	else
	begin
		/* csak a jelek */
		/* szomszedos sor: csuszik a sav; kulonben a regi es az uj sor ujra */
		if ((Sel = Regi + 1) or (Sel + 1 = Regi)) then
		begin
			Csusztat();
			return;
		end;
		y := LISTA_Y + (Regi - Top) * 12;
		SorRajz(Regi);
		y := LISTA_Y + (Sel - Top) * 12;
		SorRajz(Sel);
	end;
end;


/* a forgo logo rajzolasa: hatter vissza (LastPosition) -> Draw (menti a hatteret, rajzol) -> UpdateLastPos (Ugh-minta) */
procedure LogoRajz();
begin
	Logo.RestoreBackground();
	Logo.SetPosition();
	Logo.Draw();
	Logo.UpdateLastPos();
end;


procedure UjKonyvtar();
begin
	Olvas();
	Rajz();
	LogoRajz();		/* a Rajz torolte a kepet; a hatterpuffer is fekete, igy a visszaallitas nem art */
end;


procedure Szulo();
begin
	if (UtHossz > 1) then
	begin
		k := UtHossz;
		k := k - 1;
		while (Ut[k] <> 92) do k := k - 1;
		if (k = 0) then k := 1;		/* a gyoker \ marad */
		Ut[k] := 0;
		UtHossz := k;
		UjKonyvtar();
	end;
end;


procedure Enter();
begin
	if (Db = 0) then return;
	BejCim(Sel);
	if (p[0] = 46) then
	begin
		if (p[1] = 46) then Szulo();		/* .. */
		return;
	end;
	NevMasol();
	if ((p[11] & 16) <> 0) then
	begin
		/* konyvtar: hozzafuzes az uthoz */
		if (UtHossz + NevHossz > 60) then return;
		if (UtHossz > 1) then
		begin
			Ut[UtHossz] := 92;
			UtHossz := UtHossz + 1;
		end;
		k := 0;
		while (k < NevHossz) do
		begin
			Ut[UtHossz] := Nev[k];
			UtHossz := UtHossz + 1;
			k := k + 1;
		end;
		Ut[UtHossz] := 0;
		UjKonyvtar();
		return;
	end;
	/* fajl */
	b := 0;
	if (p[8] = 83) then
		if (p[9] = 84) then
			if (p[10] = 67) then b := 1;
	if (b = 0) then
	begin
		Allapot("Csak .STC fájl játszható");
		return;
	end;
	Allapot("Szólna: ");
	Ir16(Ir16_X, ALLAPOT_Y, #Nev);
end;


procedure Vegrehajt();
begin
	if (Gomb = 1) then
	begin
		if (Sel > 0) then UjSel(Sel - 1);
	end;
	if (Gomb = 2) then
	begin
		if (Sel + 1 < Db) then UjSel(Sel + 1);
	end;
	if (Gomb = 3) then
	begin
		if (Sel >= LATHATO) then UjSel(Sel - LATHATO)
		else
		if (Sel > 0) then UjSel(0);
	end;
	if (Gomb = 4) then
	begin
		if (Db > 0) then
		begin
			a := Sel;
			a := a + LATHATO;
			if (a >= Db) then
			begin
				if (Sel <> Db - 1) then UjSel(Db - 1);
			end
			else
				UjSel(Sel + LATHATO);
		end;
	end;
	if (Gomb = 5) then Enter();
	if (Gomb = 6) then Szulo();
end;


/* ---------------------------------------------------------------- foprogram */
begin
	GE::SetGraphics(GE::GRAPHICS16);
	GE::Init(GE::DIRECT_TO_SCREEN);			/* a firmware IT-kezelot kikapcsolja */
	GE::SetMemory(GE::MEM_VID_ON);			/* U0, U1, VID, SYS */
	GE::SetBorder(GE::BORDER_BLACK);
	Sav_L := SAV_SZIN & $AA;
	Sav_R := SAV_SZIN & $55;

	Ut[0] := 92;		/* \ */
	Ut[1] := 0;
	UtHossz := 1;
	GE::ClearScreen(GE::GR16_COLOR_BLACK);
	Logo.Init(#Logo_Data, LOGO_X, LOGO_Y, True);	/* True: hatterpuffer (fekete) */
	Logo.InitAnimation(LOGO_FAZIS, LOGO_KESL, GE::LOOP_FORWARD);
	Logo.SetPosition();
	Logo.Draw();
	Logo.UpdateLastPos();
	UjKonyvtar();

	ElozoGomb := 0;
	while (true) do
	begin
		GE::WaitForSync();
		Logo.Animation();
		if (Logo.WasAnimated) then
		begin
			Logo.WasAnimated := False;	/* a GE nem torli magatol */
			LogoRajz();
		end;
		GE::GetKeyboard();
		Gomb := 0;
		if (GE::Pressed(GE::JOY1_UP)) then Gomb := 1;
		if (GE::Pressed(GE::JOY1_DOWN)) then Gomb := 2;
		if (GE::Pressed(GE::JOY1_LEFT)) then Gomb := 3;
		if (GE::Pressed(GE::JOY1_RIGHT)) then Gomb := 4;
		if (GE::Pressed(GE::KEY_RET)) then Gomb := 5;
		if (GE::Pressed(GE::KEY_ESC)) then Gomb := 6;
		if (Gomb = 0) then
			ElozoGomb := 0
		else
		if (Gomb <> ElozoGomb) then
		begin
			ElozoGomb := Gomb;
			Ismetles := 20;
			Vegrehajt();
		end
		else
		if (Gomb < 5) then
		begin
			/* nyomva tartott nyil: ismetles */
			Ismetles := Ismetles - 1;
			if (Ismetles = 0) then
			begin
				Ismetles := 3;
				Vegrehajt();
			end;
		end;
	end;
end.
