program SIDPelda;
@use "GE"
@use "SID"

/* Minta a SID unithoz: háttérzene egy egyszerű "játék" alatt - egy négyzet pattog, képkockánként mozog.
   Bármely gomb = vége. A dal a $6000-on (stc2bin.py -c 6000), a paletta a $5000-on; a táblák a $F000-$FFFF-en (U3),
   ezért a lejátszás alatt GE::MEM_48K_VID a lapozás (U0, U1, VID, U3). */

var
	DemoDal		:	incbin("resources/lejatszo/demo_dal.bin", $6000);
	DemoPaletta	:	incbin("resources/lejatszo/demo_paletta.bin", $5000);
	x, y, dx, dy, Gomb	:	byte;

/* Gomb := 1, ha valamelyik billentyű le van nyomva (a billentyűzet-sorok közvetlenül: port 3, port $58) */
procedure Billentyu();
begin
	asm("
		ld	a,($0B11)
		and	$F0
		ld	b,10
	PeSor:
		out	($03),a
		ld	c,a
		in	a,($58)
		inc	a
		jr	nz,PeVan
		ld	a,c
		inc	a
		djnz	PeSor
		xor	a
		jr	PeKi
	PeVan:
		ld	a,1
	PeKi:
		ld	(Gomb),a
		ld	a,($0B11)
		out	($03),a
	");
end;

begin
	GE::Init(GE::DIRECT_TO_SCREEN);
	GE::SetGraphics(GE::GRAPHICS16);
	GE::ClearScreen(GE::GR16_COLOR_BLACK);
	GE::SetMemory(GE::MEM_48K_VID);

	SID::Init(#DemoDal, #DemoPaletta, $F0);
	SID::Start();

	x := 10;
	y := 50;
	dx := 1;
	dy := 2;
	Gomb := 1;
	while (Gomb = 1) do Billentyu();		/* a LOAD RETURN-je */
	while (Gomb = 0) do
	begin
		SID::Sync();						/* képkocka-szinkron (a kép alja) */
		GE::FillRect(x, y, 4, 16, GE::GR16_COLOR_BLACK);
		x := x + dx;
		y := y + dy;
		if ((x = 0) or (x = 60)) then dx := 0 - dx;
		if ((y = 0) or (y = 224)) then dy := 0 - dy;
		GE::FillRect(x, y, 4, 16, GE::GR16_COLOR_YELLOW);
		SID::Play();						/* a zene léptetése */
		Billentyu();
	end;

	SID::Stop();
	GE::ClearScreen(GE::GR16_COLOR_BLACK);
	while (true) do begin end;
end.
