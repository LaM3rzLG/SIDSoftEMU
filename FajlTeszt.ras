program FajlTeszt;
@use "TVC"

/* FajlTeszt - lemezmuveletek proba (2026-10-31): miert lesz 0 byte-os a mentett fajl a SIDSoftEMU-ban?
   N = nem letezo fajl megnyitasa (SID_TVC\LNINJA\99.STC), S = SID\LNINJA.SID vegigolvasasa 1 KB-onkent + zaras,
   W = mentes: SID_TVC\LNINJA\Tn.STC (n = 0, 1, ...), 2 + 5120 byte a $5000-rol.
   Kiiras: a ROM-hivasok utani A es F (F bit 6 = Z = siker), BC (maradek). Build: bash resources/build_fajlteszt.sh */

var
	NemLetezo	:	array[22] of byte = (21, $53, $49, $44, $5F, $54, $56, $43, $5C, $4C, $4E, $49, $4E, $4A, $41, $5C, $39, $39, $2E, $53, $54, $43);
	SidNev		:	array[15] of byte = (14, $53, $49, $44, $5C, $4C, $4E, $49, $4E, $4A, $41, $2E, $53, $49, $44);
	IrNev		:	array[23] of byte = (22, $5C, $53, $49, $44, $5F, $54, $56, $43, $5C, $4C, $4E, $49, $4E, $4A, $41, $5C, $54, $30, $2E, $53, $54, $43);
	Puffer		:	array[1024] of byte;
	Eredm		:	array[8] of byte;	/* 0,1: A,F | 2,3: BC lo,hi | 4,5: A,F | 6,7: hossz */
	Hex			:	array[3] of byte;
	Kod, Sor, i	:	byte;
	Hossz		:	integer;

procedure HexKi(x, y, v : byte);
begin
	Hex[0] := (v >> 4) + $30;
	if (Hex[0] > $39) then Hex[0] := Hex[0] + 7;
	Hex[1] := (v & 15) + $30;
	if (Hex[1] > $39) then Hex[1] := Hex[1] + 7;
	Hex[2] := 0;
	TVC::WriteAt(x, y, #Hex);
end;

procedure EredmKi(nev : byte);
begin
	for i := 0 to 8 do
		HexKi(4 + i * 3, Sor, Eredm[i]);
	inc(Sor);
	if (Sor > 23) then Sor := 6;
end;

procedure Nyit();
begin
	asm("
		xor	a
		ld	($0B0A),a
		ld	de,NemLetezo
		rst	$30
		db	$D3
		push	af
		pop	hl
		ld	a,h
		ld	(Eredm),a
		ld	a,l
		ld	(Eredm+1),a
	");
end;

procedure Olvas();
begin
	asm("
		xor	a
		ld	($0B0A),a
		ld	de,SidNev
		rst	$30
		db	$D3
		push	af
		pop	hl
		ld	a,h
		ld	(Eredm),a
		ld	a,l
		ld	(Eredm+1),a
		ret	nz
		ld	hl,0
		ld	(OlvOssz),hl
	OlvKor:
		ld	de,Puffer
		ld	bc,1024
		rst	$30
		db	$D2
		ld	(Eredm+2),bc
		ld	hl,1024
		or	a
		sbc	hl,bc
		ex	de,hl
		ld	hl,(OlvOssz)
		add	hl,de
		ld	(OlvOssz),hl
		ld	a,b
		or	c
		jr	z,OlvKor
		xor	a
		rst	$30
		db	$D4
		push	af
		pop	hl
		ld	a,h
		ld	(Eredm+4),a
		ld	a,l
		ld	(Eredm+5),a
		ld	hl,(OlvOssz)
		ld	(Eredm+6),hl
		ret
	OlvOssz:
		dw	0
	");
end;

procedure Vissza();
begin
	asm("
		xor	a
		ld	($0B0A),a
		ld	de,OlvNev
		rst	$30
		db	$D3
		push	af
		pop	hl
		ld	a,h
		ld	(Eredm),a
		ld	a,l
		ld	(Eredm+1),a
		ret	nz
		ld	de,Puffer
		ld	bc,1024
		rst	$30
		db	$D2
		ld	(Eredm+2),bc
		ld	hl,(Puffer)
		ld	(Eredm+6),hl		;	az elso 2 byte = a mentett hossz (5120 = $1400)
		xor	a
		rst	$30
		db	$D4
		ret
	OlvNev:
		db	22
		db	$5C, $53, $49, $44, $5F, $54, $56, $43, $5C, $4C, $4E, $49, $4E, $4A, $41, $5C, $54, $31, $2E, $53, $54, $43
	");
end;

procedure Ir();
begin
	asm("
		xor	a
		ld	($0B6B),a
		ld	($0B0A),a			;	PROBA: mint olvasaskor
		ld	de,IrNev
		rst	$30
		db	$53
		push	af
		pop	hl
		ld	a,h
		ld	(Eredm),a
		ld	a,l
		ld	(Eredm+1),a
		ret	nz
		ld	hl,5120
		ld	(IrHossz),hl
		ld	de,IrHossz
		ld	bc,2
		rst	$30
		db	$52
		ld	de,$5000
		ld	bc,5120
		rst	$30
		db	$52
		ld	(Eredm+2),bc
		rst	$30
		db	$54
		push	af
		pop	hl
		ld	a,h
		ld	(Eredm+4),a
		ld	a,l
		ld	(Eredm+5),a
		ret
	IrHossz:
		dw	0
	");
end;

begin
	TVC::SetGraphicsMode(TVC::GRAPHICS4);
	TVC::Cls();
	TVC::WriteAt(1, 1, "FajlTeszt: N nyit (nincs)");
	TVC::WriteAt(1, 2, "S olvas SID, W ir Tn, R olvas T1");
	TVC::WriteAt(1, 4, "   A  F  C  B  A  F  hossz");
	Sor := 6;
	while (true) do
	begin
		Kod := TVC::ReadKey();
		for i := 0 to 8 do Eredm[i] := 0;
		if (Kod = $6E) then begin TVC::WriteAt(1, Sor, "N"); Nyit(); EredmKi(0); end;
		if (Kod = $73) then begin TVC::WriteAt(1, Sor, "S"); Olvas(); EredmKi(0); end;
		if (Kod = $77) then begin TVC::WriteAt(1, Sor, "W"); IrNev[18] := $30; Ir(); EredmKi(0); end;
		if (Kod = $78) then begin TVC::WriteAt(1, Sor, "X"); IrNev[18] := $31; Ir(); EredmKi(0); end;
		if (Kod = $72) then begin TVC::WriteAt(1, Sor, "R"); Vissza(); EredmKi(0); end;
	end;
end.
