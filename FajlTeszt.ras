program FajlTeszt;
@use "GE"

/* FajlTeszt - a SIDSoftEMU mini fajlkezelojenek probaprogramja (2026-10-31), TRSE + GE unit.
   - Kiiras: a WaterPumpGame SAJAT szovegkiiroja (Ir: aranyos, pixelszelessegu betuk, 1 bites font), valtozatlanul
     atveve; csak a sorpuffer lett Ir_Buf (a WPG-ben $1460). Betukeszlet: resources/font.bin (1 byte magassag +
     109 byte szelesseg + kep; ASCII 32..122 + ekezetek). Ekezet a forrasban Latin-1-gyel; o"/u" helyett o^/u^.
   - Billentyuk: GE::GetKeyboard + GE::Pressed (a nyilak a matrix 8. soraban: JOY1_UP/DOWN/LEFT/RIGHT).
     Nyomva tartva ismetel (elso ismetles 20 kep utan, aztan 3 kepenkent).
   - Mozgaskor csak a regi es az uj sor jele rajzolodik ujra; a teljes lista csak lapozaskor / konyvtarvaltaskor.
   - Konyvtar: a lemez-ROM FISH hivasa (MOPS rst $30 / $DB; 04H = elso, 05H = kovetkezo bejegyzes) - FishHivas.
     ROM-hivas elott GE::EnableTVCITHandler, utana Disable.
   Fel/Le = valasztas, Balra/Jobbra = lapozas, Enter = konyvtarba be / .STC (most csak kiirja), ESC = feljebb. */

var
	Font_Data	:	incbin("resources/font.bin");

	const LATHATO	: byte = 22;		/* ennyi listasor latszik */
	const LISTA_Y	: byte = 26;		/* az elso listasor kepsora */
	const ALLAPOT_Y	: byte = 208;		/* uzenetsor */
	const NEV_X		: byte = 2;			/* oszlopok (byte = 4 pont) */
	const MERET_JOBB: byte = 40;		/* a meret jobb szele */
	const KVT_X		: byte = 30;

	Lista		:	array[4096] of byte;	/* 256 bejegyzes x 16: nev 8, kit. 3, attr 1, meret 4 */
	MintaFcb	:	array[64] of byte;		/* keresesi minta (????????.???) */
	TalaltFcb	:	array[64] of byte;		/* a talalt bejegyzes */
	Fpb			:	array[8] of byte;		/* FISH parameterblokk: IX, HL, DE, BC */
	Ut			:	array[64] of byte;		/* aktualis konyvtar, 0-val zarva; gyoker = \ */
	Nev			:	array[14] of byte;		/* a bejegyzes neve (nev.kit) */
	SzamSz		:	array[8] of byte;		/* szam szovegkent */

	UtHossz, NevHossz, Db, Sel, Top, Regi, HibaKod	:	byte;
	FishKod, FishHiba	:	byte;
	Gomb, ElozoGomb, Ismetles	:	byte;
	i, j, k, b, y, Elso	:	byte;
	p			:	^byte;
	a, Meret	:	integer;

	/* a WaterPumpGame Ir valtozoi */
	Ir_X							:	byte = 0;		/* be: x (byte); ki: a kovetkezo szabad byte-oszlop */
	Ir_Y							:	byte = 0;
	Ir_Szoveg						:	^byte;
	Ir_Cim							:	integer = 0;
	Ir_Szel							:	byte = 0;
	Ir_Hossz						:	byte = 0;		/* az Ir_Hossza eredmenye (byte) */
	Ir_Px, Ir_Bdb, Ir_H				:	byte = 0;
	Ir_Sor0, Ir_Dst					:	integer = 0;
	Ir_Buf							:	array[34] of byte;	/* sorpuffer (a WPG-ben $1460) */


/* ---------------------------------------------------------------- SAJAT SZOVEGKIIRO (WaterPumpGame) */
Procedure Ir(Ir_X, Ir_Y : global byte; Ir_Szoveg : global ^byte);
	begin
		asm("
			ld a,[Ir_Y]
			ld l,a
			ld h,0
			add hl,hl
			add hl,hl
			add hl,hl
			add hl,hl
			add hl,hl
			add hl,hl
			ld de,[GE_ScreenAddr]
			add hl,de
			ld a,[Ir_X]
			ld e,a
			ld d,0
			add hl,de
			ld [Ir_Cim],hl
			ld [Ir_Dst],hl
			ld hl,[Ir_Szoveg]
			call Ir_PxSzel
			ld [Ir_Bdb],a
			ld a,[Font_Data]
			and 15
			ld [Ir_H],a
			ld hl,Font_Data+110
			ld [Ir_Sor0],hl
			ld a,[Ir_H]
			ld b,a
IrSorCiklus:
			push bc
			ld hl,Ir_Buf
			ld b,34
			xor a
Ir_Torol:
			ld (hl),a
			inc hl
			djnz Ir_Torol
			ld [Ir_Px],a
			ld hl,[Ir_Szoveg]
Ir_Kar:
			ld a,(hl)
			or a
			jr z,Ir_Kiir
			inc hl
			call Ir_Ekezet
			cp 32
			jr c,Ir_Kar
			cp 141
			jr nc,Ir_Kar
			sub 32
			push hl
			ld e,a
			ld d,0
			ld hl,Font_Data+1
			add hl,de
			ld a,(hl)
			or a
			jr z,Ir_KarVege
			ld [Ir_Szel],a
			ld hl,[Ir_Sor0]
			add hl,de
			ld d,(hl)
			ld e,0
			ld a,[Ir_Px]
			ld c,a
			and 7
			jr z,Ir_NemTol
			ld b,a
Ir_Tol:
			srl d
			rr e
			djnz Ir_Tol
Ir_NemTol:
			ld a,c
			rrca
			rrca
			rrca
			and 31
			ld c,a
			ld b,0
			ld hl,Ir_Buf
			add hl,bc
			ld a,(hl)
			or d
			ld (hl),a
			inc hl
			ld a,(hl)
			or e
			ld (hl),a
			ld a,[Ir_Szel]
			ld c,a
			ld a,[Ir_Px]
			add a,c
			ld [Ir_Px],a
Ir_KarVege:
			pop hl
			jr Ir_Kar
Ir_Kiir:
			call IrKiirRut
			pop bc
			djnz IrSorCiklus
			ld a,[Ir_Bdb]
			ld e,a
			ld d,0
			ld hl,[Ir_Cim]
			add hl,de
			ld [Ir_Cim],hl
			ld a,[Ir_X]
			add a,e
			ld [Ir_X],a
			jp Ir_Vege
IrKiirRut:
			ld a,[Ir_Bdb]
			or a
			jr z,IrSorVege
			ld b,a
			ld hl,Ir_Buf
			ld de,[Ir_Dst]
Ir_Byte:
			ld a,(hl)
			and $F0
			ld (de),a
			inc de
			dec b
			jr z,IrSorVege
			ld a,(hl)
			rlca
			rlca
			rlca
			rlca
			and $F0
			ld (de),a
			inc de
			inc hl
			djnz Ir_Byte
IrSorVege:
			ld hl,[Ir_Dst]
			ld de,64
			add hl,de
			ld [Ir_Dst],hl
			ld hl,[Ir_Sor0]
			ld de,109
			add hl,de
			ld [Ir_Sor0],hl
			ret
Ir_PxSzel:
			ld c,0
Ir_PKov:
			ld a,(hl)
			or a
			jr z,Ir_PVege
			inc hl
			call Ir_Ekezet
			cp 32
			jr c,Ir_PKov
			cp 141
			jr nc,Ir_PKov
			sub 32
			push hl
			ld e,a
			ld d,0
			ld hl,Font_Data+1
			add hl,de
			ld a,(hl)
			add a,c
			ld c,a
			pop hl
			jr Ir_PKov
Ir_PVege:
			ld l,c
			ld h,0
			inc hl
			inc hl
			inc hl
			srl h
			rr l
			srl h
			rr l
			ld a,l
			ret
; Ekezetes betu: a forras Latin-1 kodja ($C0..$FF) -> a font kodja (123..140); ismeretlen -> 0 (kimarad).
; A hosszu o es u (o, u ketto vesszovel) nincs a Latin-1-ben: a forrasban o^/u^ (kalapos) all helyettuk. A: a karakter; HL marad, DE romlik.
Ir_Ekezet:
			cp $C0
			ret c
			push hl
			sub $C0
			ld d,a
			and $1F
			ld e,a
			ld a,d
			ld d,0
			ld hl,Ir_EkTab
			add hl,de
			ld e,a
			ld a,(hl)
			or a
			jr z,Ir_EkX
			bit 5,e
			jr z,Ir_EkX
			add a,9
Ir_EkX:
			pop hl
			ret
Ir_EkTab:
			db 0,123,0,0,0,0,0,0,0,124,0,0,0,125,0,0
			db 0,0,0,126,128,0,127,0,0,0,129,131,130,0,0,0
Ir_Vege:
		");
	end;

/* Egy szöveg szélessége byte-ban (a betűk szélességének összege) -> Ir_Hossz */
Procedure Ir_Hossza(Ir_Szoveg : global ^byte);
	begin
		asm("
			ld hl,[Ir_Szoveg]
			call Ir_PxSzel
			ld [Ir_Hossz],a
		");
	end;

/* ---------------------------------------------------------------- az egyetlen asm: FISH-hivas
   C = FishKod (04H elso / 05H kovetkezo keresese), DE -> FPB {IX = 0, HL = ut, DE = MintaFcb, BC = TalaltFcb};
   eredmeny: FishHiba (0 = van bejegyzes). A hivas a $70-es lapozassal megy (mint a SIDSoftEMU-ban). */
procedure FishHivas();
begin
	asm("
		push	ix
		push	iy
		ld	hl,0
		ld	(Fpb),hl
		ld	hl,Ut
		ld	(Fpb+2),hl
		ld	hl,MintaFcb
		ld	(Fpb+4),hl
		ld	hl,TalaltFcb
		ld	(Fpb+6),hl
		ld	a,($0003)
		push	af
		ld	a,$70
		ld	($0003),a
		out	($02),a
		ld	a,(FishKod)
		ld	c,a
		ld	de,Fpb
		rst	$30
		db	$DB
		ld	(FishHiba),a
		pop	af
		ld	($0003),a
		out	($02),a
		pop	iy
		pop	ix
	");
end;


/* ---------------------------------------------------------------- p := a Sel-edik ... k-adik bejegyzes cime */
procedure BejCim(n : byte);
begin
	a := n;
	a := a * 16;
	p := #Lista;
	p := p + a;
end;


/* a p bejegyzes neve -> Nev (szokozok nelkul, nev.kit), NevHossz */
procedure NevMasol();
begin
	NevHossz := 0;
	j := 0;
	while (j < 8) do
	begin
		b := p[j];
		if (b <> 32) then
		begin
			Nev[NevHossz] := b;
			NevHossz := NevHossz + 1;
		end;
		j := j + 1;
	end;
	if (p[8] <> 32) then
	begin
		Nev[NevHossz] := 46;		/* . */
		NevHossz := NevHossz + 1;
		while (j < 11) do
		begin
			b := p[j];
			if (b <> 32) then
			begin
				Nev[NevHossz] := b;
				NevHossz := NevHossz + 1;
			end;
			j := j + 1;
		end;
	end;
	Nev[NevHossz] := 0;
end;


/* Meret -> SzamSz (vezeto nullak nelkul) */
procedure Jegy(oszto : integer);
begin
	b := 48;
	while (Meret >= oszto) do
	begin
		Meret := Meret - oszto;
		b := b + 1;
	end;
	if (b <> 48) then Elso := 0;
	if (Elso = 0) then
	begin
		SzamSz[k] := b;
		k := k + 1;
	end;
end;

procedure SzamIr();
begin
	k := 0;
	Elso := 1;
	Jegy(10000);
	Jegy(1000);
	Jegy(100);
	Jegy(10);
	Elso := 0;
	Jegy(1);
	SzamSz[k] := 0;
end;


/* ---------------------------------------------------------------- kepernyo */
/* a lista n-edik bejegyzese az y kepsorba */
procedure SorRajz(n : byte);
begin
	GE::FillRect(0, y, 64, 8, 0);
	if (n = Sel) then Ir(0, y, ">");
	BejCim(n);
	NevMasol();
	Ir(NEV_X, y, #Nev);
	if ((p[11] & 16) <> 0) then
		Ir(KVT_X, y, "<Könyvtár>")
	else
	begin
		/* meret KB-ban, felfele kerekitve: (b1 >> 2) + b2 * 64 */
		Meret := p[14];
		Meret := Meret * 64;
		b := p[13];
		b := b >> 2;
		Meret := Meret + b;
		b := p[13] & 3;
		if (p[12] <> 0) then b := 1;
		if (b <> 0) then Meret := Meret + 1;
		SzamIr();
		Ir_Hossza(#SzamSz);
		Ir(MERET_JOBB - Ir_Hossz, y, #SzamSz);
		Ir(MERET_JOBB + 1, y, "KB");
	end;
end;


procedure ListaRajz();
begin
	i := 0;
	while (i < LATHATO) do
	begin
		y := LISTA_Y + i * 8;
		a := Top;
		a := a + i;
		if (a < Db) then
			SorRajz(Top + i)
		else
			GE::FillRect(0, y, 64, 8, 0);
		i := i + 1;
	end;
	if (Db = 0) then
	begin
		Ir(NEV_X, LISTA_Y, "(üres) hiba: ");
		Meret := HibaKod;
		SzamIr();
		Ir(Ir_X, LISTA_Y, #SzamSz);
	end;
end;


procedure Allapot(szoveg : ^byte);
begin
	GE::FillRect(0, ALLAPOT_Y, 64, 8, 0);
	Ir(0, ALLAPOT_Y, szoveg);
end;


procedure Rajz();
begin
	GE::ClearScreen(GE::GR4_COLOR0);
	Ir(0, 0, "SIDSoftEMU - fájlkezelô (teszt)");
	Ir(0, 11, #Ut);
	Ir(0, 222, "Fel/Le: választás, Balra/Jobbra: lapozás");
	Ir(0, 231, "Enter: megnyitás, ESC: vissza");
	ListaRajz();
end;


/* ---------------------------------------------------------------- konyvtar beolvasasa -> Lista, Db */
procedure Olvas();
begin
	Db := 0;
	MintaFcb[0] := $FF;
	k := 1;
	while (k < 8) do
	begin
		MintaFcb[k] := 0;
		k := k + 1;
	end;
	while (k < 19) do
	begin
		MintaFcb[k] := $3F;		/* ? */
		k := k + 1;
	end;
	GE::EnableTVCITHandler();
	FishKod := 4;
	FishHivas();
	while (FishHiba = 0) do
	begin
		/* a . bejegyzes kimarad */
		b := 1;
		if (TalaltFcb[8] = 46) then
			if (TalaltFcb[9] = 32) then b := 0;
		if (b = 1) then
		begin
			BejCim(Db);
			k := 0;
			while (k < 12) do
			begin
				p[k] := TalaltFcb[k + 8];
				k := k + 1;
			end;
			while (k < 16) do
			begin
				p[k] := TalaltFcb[k + 24];		/* meret: TalaltFcb[36..39] */
				k := k + 1;
			end;
			Db := Db + 1;
		end;
		FishKod := 5;
		if (Db = 255) then FishHiba := 1
		else FishHivas();
	end;
	HibaKod := FishHiba;
	GE::DisableTVCITHandler();
	Sel := 0;
	Top := 0;
end;


/* ---------------------------------------------------------------- mozgas */
procedure UjSel(n : byte);
begin
	Regi := Sel;
	Sel := n;
	if (Sel < Top) then
	begin
		Top := Sel;
		ListaRajz();
	end
	else
	if (Sel - Top >= LATHATO) then
	begin
		Top := Sel - LATHATO + 1;
		ListaRajz();
	end
	else
	begin
		/* csak a jelek */
		Ir(0, LISTA_Y + (Regi - Top) * 8, " ");
		Ir(0, LISTA_Y + (Sel - Top) * 8, ">");
	end;
end;


procedure UjKonyvtar();
begin
	Olvas();
	Rajz();
end;


procedure Szulo();
begin
	if (UtHossz > 1) then
	begin
		k := UtHossz;
		k := k - 1;
		while (Ut[k] <> 92) do k := k - 1;
		if (k = 0) then k := 1;		/* a gyoker \ marad */
		Ut[k] := 0;
		UtHossz := k;
		UjKonyvtar();
	end;
end;


procedure Enter();
begin
	if (Db = 0) then return;
	BejCim(Sel);
	if (p[0] = 46) then
	begin
		if (p[1] = 46) then Szulo();		/* .. */
		return;
	end;
	NevMasol();
	if ((p[11] & 16) <> 0) then
	begin
		/* konyvtar: hozzafuzes az uthoz */
		if (UtHossz + NevHossz > 60) then return;
		if (UtHossz > 1) then
		begin
			Ut[UtHossz] := 92;
			UtHossz := UtHossz + 1;
		end;
		k := 0;
		while (k < NevHossz) do
		begin
			Ut[UtHossz] := Nev[k];
			UtHossz := UtHossz + 1;
			k := k + 1;
		end;
		Ut[UtHossz] := 0;
		UjKonyvtar();
		return;
	end;
	/* fajl */
	b := 0;
	if (p[8] = 83) then
		if (p[9] = 84) then
			if (p[10] = 67) then b := 1;
	if (b = 0) then
	begin
		Allapot("Csak .STC fájl játszható");
		return;
	end;
	Allapot("Szólna: ");
	Ir(Ir_X, ALLAPOT_Y, #Nev);
end;


procedure Vegrehajt();
begin
	if (Gomb = 1) then
	begin
		if (Sel > 0) then UjSel(Sel - 1);
	end;
	if (Gomb = 2) then
	begin
		if (Sel + 1 < Db) then UjSel(Sel + 1);
	end;
	if (Gomb = 3) then
	begin
		if (Sel >= LATHATO) then UjSel(Sel - LATHATO)
		else
		if (Sel > 0) then UjSel(0);
	end;
	if (Gomb = 4) then
	begin
		if (Db > 0) then
		begin
			a := Sel;
			a := a + LATHATO;
			if (a >= Db) then
			begin
				if (Sel <> Db - 1) then UjSel(Db - 1);
			end
			else
				UjSel(Sel + LATHATO);
		end;
	end;
	if (Gomb = 5) then Enter();
	if (Gomb = 6) then Szulo();
end;


/* ---------------------------------------------------------------- foprogram */
begin
	GE::SetGraphics(GE::GRAPHICS4);
	GE::Init(GE::DIRECT_TO_SCREEN);			/* a firmware IT-kezelot kikapcsolja */
	GE::SetMemory(GE::MEM_VID_ON);			/* U0, U1, VID, SYS */
	GE::SetPalette(0, GE::PALETTE_BLACK);
	GE::SetPalette(1, GE::PALETTE_GREEN);
	GE::SetPalette(2, GE::PALETTE_RED);
	GE::SetPalette(3, GE::PALETTE_YELLOW);
	GE::SetBorder(GE::BORDER_BLACK);

	Ut[0] := 92;		/* \ */
	Ut[1] := 0;
	UtHossz := 1;
	UjKonyvtar();

	ElozoGomb := 0;
	while (true) do
	begin
		GE::WaitForSync();
		GE::GetKeyboard();
		Gomb := 0;
		if (GE::Pressed(GE::JOY1_UP)) then Gomb := 1;
		if (GE::Pressed(GE::JOY1_DOWN)) then Gomb := 2;
		if (GE::Pressed(GE::JOY1_LEFT)) then Gomb := 3;
		if (GE::Pressed(GE::JOY1_RIGHT)) then Gomb := 4;
		if (GE::Pressed(GE::KEY_RET)) then Gomb := 5;
		if (GE::Pressed(GE::KEY_ESC)) then Gomb := 6;
		if (Gomb = 0) then
			ElozoGomb := 0
		else
		if (Gomb <> ElozoGomb) then
		begin
			ElozoGomb := Gomb;
			Ismetles := 20;
			Vegrehajt();
		end
		else
		if (Gomb < 5) then
		begin
			/* nyomva tartott nyil: ismetles */
			Ismetles := Ismetles - 1;
			if (Ismetles = 0) then
			begin
				Ismetles := 3;
				Vegrehajt();
			end;
		end;
	end;
end.
